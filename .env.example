# Coldstack environment. Copy to .env.local and fill in the values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (reply categorization)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Smartlead
SMARTLEAD_API_KEY=
SMARTLEAD_API_BASE_URL=https://server.smartlead.ai/api/v1
SMARTLEAD_WEBHOOK_SECRET=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# This deployment's public URL
APP_BASE_URL=http://localhost:3000

# Encrypts integration credentials stored by the app. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_ENCRYPTION_KEY=

# --- Notifications (optional) ---------------------------------------------
# Email + Slack notification channels are managed in-app (Settings). Slack
# needs no env config — paste an incoming-webhook URL in the UI. Email
# notifications need ONE transport below plus a From address; the provider is
# auto-detected from which credentials are set (or forced via EMAIL_PROVIDER).

# NOTIFY_EMAIL_FROM="Coldstack <inbox@example.com>"

# Option A: Resend (https://resend.com)
# RESEND_API_KEY=

# Option B: any SMTP server
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false        # true = implicit TLS (usually port 465)

# Force a provider when both are configured: resend | smtp
# EMAIL_PROVIDER=
